# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL + pgvector
POSTGRES_USER=sutra_admin
POSTGRES_PASSWORD=sutra_password
POSTGRES_DB=sutra_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sutra_admin:sutra_password@localhost:5432/sutra_db
DATABASE_SYNC_URL=postgresql://sutra_admin:sutra_password@localhost:5432/sutra_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Supabase (Auth, Storage, Database, Realtime)
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# VERA Memory & Embedding System
VERA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VERA_MEMORY_MODEL=qwen-vera:4b
VERA_MEMORY_TOP_K=8
VERA_MEMORY_THRESHOLD=0.70
VERA_MEMORY_DEDUP_THRESHOLD=0.90
OLLAMA_BASE_URL=http://localhost:11434

# Object Storage (MinIO / S3 / Supabase Storage)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=sutra_minio_admin
S3_SECRET_ACCESS_KEY=sutra_minio_secret
S3_BUCKET_NAME=sutra-evidence
S3_REGION=us-east-1

# API & Web Ports
API_PORT=8000
WEB_PORT=3000

# AI Provider Keys (Pluggable)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
